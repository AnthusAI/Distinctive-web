{
  "siteId": "distinctive",
  "stackName": "amplify-app-shell-distinctive-cms",
  "repository": "https://github.com/AnthusAI/Distinctive-web",
  "brand": "distinctive",
  "frontend": "markus-static",
  "aws": { "profile": "papyrus-production", "accountId": "712236451410", "region": "us-east-1" },
  "papyrusVersion": "5.43.0",
  "cms": {
    "staging": false,
    "cognitoDomainPrefix": "papyrus-distinctive-cms",
    "applyCognitoDomainPrefix": true,
    "buildComputeType": "STANDARD_8GB",
    "environment": {
      "PAPYRUS_ENABLE_CONSOLE_RESPONDER": "false",
      "PAPYRUS_ENABLE_SLACK": "false",
      "PAPYRUS_ENABLE_INBOUND_EMAIL": "false",
      "PAPYRUS_ENABLE_STORAGE_BACKUPS": "false",
      "PAPYRUS_OAUTH_REDIRECT_URLS": "http://localhost:3001/,https://distinctive-mark.com/"
    },
    "siteOrigin": "https://distinctive-mark.com"
  },
  "github": {
    "owner": "AnthusAI",
    "repo": "Distinctive-web",
    "branches": [
      "main"
    ],
    "ownerId": 152415604,
    "repoId": 1427406054
  }
}

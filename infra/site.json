{
  "siteId": "distinctive",
  "stackName": "amplify-app-shell-distinctive-cms",
  "repository": "https://github.com/AnthusAI/Distinctive-web",
  "brand": "distinctive",
  "frontend": "markus-static",
  "papyrusVersion": "3.2.0",
  "cms": {
    "staging": true,
    "cognitoDomainPrefix": "papyrus-distinctive-cms",
    "applyCognitoDomainPrefix": true,
    "environment": {
      "PAPYRUS_ENABLE_CONSOLE_RESPONDER": "false",
      "PAPYRUS_ENABLE_SLACK": "false",
      "PAPYRUS_ENABLE_INBOUND_EMAIL": "false",
      "PAPYRUS_ENABLE_STORAGE_BACKUPS": "false",
      "PAPYRUS_OAUTH_REDIRECT_URLS": "http://localhost:3001/"
    }
  },
  "github": {
    "owner": "AnthusAI",
    "repo": "Distinctive-web",
    "branches": ["main"]
  }
}
